## Props

### TextRepel

<ApiTable
	headers={["Prop", "Type", "Default"]}
	keys={["prop", "type", "default"]}
	data={[
		{
			prop: "children",
			type: "Snippet",
			default: "—",
			description: "The text/content to split and repel from the cursor.",
		},
		{
			prop: "mode",
			type: '"words" | "chars"',
			default: '"words"',
			description: "Whether to split and animate words or characters.",
		},
		{
			prop: "strength",
			type: "number",
			default: "18",
			description: "Maximum translation distance in pixels near the cursor.",
		},
		{
			prop: "radius",
			type: "number",
			default: "160",
			description: "Cursor influence radius in pixels.",
		},
		{
			prop: "falloffPower",
			type: "number",
			default: "1.5",
			description:
				"Controls how quickly the repulsion fades with distance.",
		},
		{
			prop: "duration",
			type: "number",
			default: "0.45",
			description: "Animation duration in seconds.",
		},
		{
			prop: "ease",
			type: "string",
			default: '"power3.out"',
			description: "GSAP ease identifier used by the translations.",
		},
		{
			prop: "hoverTarget",
			type: "HTMLElement | null",
			default: "null",
			description:
				"Optional external element that should drive pointer movement.",
		},
		{
			prop: "class",
			type: "string",
			default: '""',
			description: "Additional classes for the wrapper element.",
		},
	]}
