## Props

### UnderlayNavigation

<ApiTable
	headers={["Prop", "Type", "Default"]}
	keys={["prop", "type", "default"]}
	data={[
		{
			prop: "links",
			type: "NavigationLink[]",
			default: "—",
			description: "Primary navigation links shown in the underlay panel.",
		},
		{
			prop: "footerGroups",
			type: "FooterGroup[]",
			default: "[]",
			description: "Optional footer link groups shown below the primary links.",
		},
		{
			prop: "brand",
			type: "Snippet",
			default: "undefined",
			description: "Snippet rendered in the foreground header.",
		},
		{
			prop: "children",
			type: "Snippet",
			default: "undefined",
			description: "Foreground content that slides over the underlay panel.",
		},
		{
			prop: "activeHref",
			type: "string",
			default: "undefined",
			description: "Href used to mark the matching primary link as active.",
		},
		{
			prop: "menuLabel",
			type: "string",
			default: '"Menu"',
			description: "Accessible and visible label for the menu trigger.",
		},
		{
			prop: "closeLabel",
			type: "string",
			default: '"Close"',
			description: "Accessible and visible label for the close trigger.",
		},
		{
			prop: "ariaLabel",
			type: "string",
			default: '"Primary navigation"',
			description: "Accessible label for the navigation region.",
		},
		{
			prop: "panelWidth",
			type: "string",
			default: '"clamp(18rem, 32vw, 24rem)"',
			description: "Width of the underlay panel as any valid CSS length.",
		},
		{
			prop: "foregroundRadius",
			type: "string",
			default: '"1rem"',
			description:
				"Target border radius for the foreground content while the menu is open.",
		},
		{
			prop: "open",
			type: "boolean",
			default: "false",
			description: "Controlled open state. Supports bind:open.",
		},
		{
			prop: "class",
			type: "string",
			default: '""',
			description: "Additional classes for the root container.",
		},
		{
			prop: "classes",
			type: "UnderlayNavigationClasses",
			default: "undefined",
			description: "Optional class overrides for internal slots.",
		},
	]}
/>

