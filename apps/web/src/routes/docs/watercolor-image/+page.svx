## Props

### WatercolorImage

<ApiTable
	headers={["Prop", "Type", "Default"]}
	keys={["prop", "type", "default"]}
	data={[
		{
			prop: "src",
			type: "string",
			default: "—",
			description: "URL of the image to be displayed.",
		},
		{
			prop: "radius",
			type: "number",
			default: "6",
			description:
				"Radius of the anisotropic watercolor filter. Higher values produce broader paint regions.",
		},
		{
			prop: "tensorPass",
			type: "boolean",
			default: "true",
			description: "Enables the structure tensor pass used by the Kuwahara filter.",
		},
		{
			prop: "kuwaharaPass",
			type: "boolean",
			default: "true",
			description: "Enables the anisotropic Kuwahara watercolor pass.",
		},
		{
			prop: "class",
			type: "string",
